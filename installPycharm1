#! /bin/bash
# =============================================================================
#  installPycharm1 — ANCIENNE VERSION, conservée pour mémoire
#
#  ⚠ OBSOLÈTE : utiliser plutôt « installPycharm », qui s'arrête en cas d'erreur
#    et crée le lien /snap nécessaire sous Debian.
#  Manuel : docs/installPycharm1.md
# =============================================================================

# Installe snapd, le gestionnaire de snaps (demande une confirmation).
sudo apt install snapd
# Installe snapd-xdg-open (paquet ancien, souvent absent des Debian récentes).
sudo apt install snapd-xdg-open
# Installe PyCharm avec accès complet au système de fichiers (--classic).
sudo snap install pycharm-community --classic
# Lance PyCharm tout de suite.
/snap/bin/pycharm-community

