#!/usr/bin/env bash
# =============================================================================
#  installAnboxPlayStore — BROUILLON INACHEVÉ, conservé pour mémoire
#
#  ⚠ OBSOLÈTE : Anbox est abandonné depuis 2023, et ce script s'arrête avant
#    d'installer Anbox ou le Play Store (il ne pose que des outils).
#    -> Pour Android sous Linux : ./installWaydroid
#  Manuel : docs/installAnboxPlayStore.md
# =============================================================================


# Met à jour la liste des paquets, puis tous les paquets (avec confirmation).
sudo apt-get update
sudo apt-get upgrade

# Outils qui auraient servi à télécharger et décompresser l'image Android :
#   wget (téléchargement), lzip et unzip (archives), squashfs-tools (image système).
sudo apt install wget lzip unzip squashfs-tools

# Gestionnaire de snaps (Anbox était distribué en snap).
sudo apt install snapd
