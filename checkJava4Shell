#!/usr/bin/env bash
# =============================================================================
#  checkJava4Shell — Recherche d'exposition et de traces d'attaque
#  Java4Shell (CVE-2026-114938), publiée le 17 novembre 2026.
#
#  LECTURE SEULE : ce script ne modifie, ne supprime et n'installe rien.
#  Il n'exécute AUCUN binaire java trouvé sur le disque (un binaire piégé
#  serait sinon lancé en root) : les versions sont lues dans les fichiers
#  « release » des JDK/JRE.
#  Seule écriture : le rapport texte dans /tmp.
#
#  Usage :  sudo bash checkJava4Shell
#
#  Sources des critères (vérifiées le 26/11/2026) :
#   - Versions corrigées : 17.0.21.1, 21.0.13.1, 25.0.5.1, 27.0.1.1
#   - Java 17 touché seulement à partir de 17.0.6 ; Java 8 et 11 non touchés
#   - Non touchés : ARM64, OpenJ9 (IBM Semeru), GraalVM native-image
#   - Exploitable seulement sur x86-64 avec AVX-512 VBMI
#     (drapeaux CPU avx512f, avx512bw, avx512vbmi, bmi2)
#   - Traces : fichiers hs_err_pid*.log, message « A fatal error has been
#     detected by the Java Runtime Environment », SIGSEGV dans libjvm,
#     Base64 de 64 « A » suivis de « = », java qui lance un shell
#   - Leurre malveillant connu : dépôt « java4shell-exposure-audit »
#  Aucun indicateur de compromission (hash, IP) n'a été publié à ce jour :
#  ce script détecte une EXPOSITION et des SIGNES SUSPECTS, pas un malware
#  précis.
# =============================================================================

set -u
LC_ALL=C

REPORT="/tmp/java4shell-$(hostname)-$(date +%Y%m%d-%H%M).txt"
exec > >(tee "$REPORT") 2>&1

NB_VULN=0
NB_ALERTE=0
TMP_FIND="$(mktemp)"
trap 'rm -f "$TMP_FIND"' EXIT

titre() { printf '\n==== %s ====\n' "$1"; }
ok()     { printf '[OK]          %s\n' "$1"; }
info()   { printf '[INFO]        %s\n' "$1"; }
vuln()   { printf '[VULNÉRABLE]  %s\n' "$1"; NB_VULN=$((NB_VULN + 1)); }
alerte() { printf '[ALERTE]      %s\n' "$1"; NB_ALERTE=$((NB_ALERTE + 1)); }

# Vrai si la version $1 est strictement inférieure à $2
ver_lt() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$1" ]
}

echo "Java4Shell (CVE-2026-114938) — contrôle de $(hostname) le $(date '+%d/%m/%Y %H:%M')"
echo "Rapport enregistré dans : $REPORT"

if [ "$(id -u)" -ne 0 ]; then
    echo
    echo "ATTENTION : lancé sans sudo. Une partie du disque et des journaux"
    echo "ne sera pas lisible : le résultat sera incomplet."
fi

# -----------------------------------------------------------------------------
titre "1. Processeur (la faille ne vise que le x86-64 avec AVX-512 VBMI)"
ARCH="$(uname -m)"
CPU_EXPLOITABLE=0
if [ "$ARCH" != "x86_64" ]; then
    ok "Architecture $ARCH : le code vulnérable ne s'exécute pas sur cette machine."
else
    MANQUANTS=""
    for f in avx512f avx512bw avx512vbmi bmi2; do
        grep -m1 '^flags' /proc/cpuinfo | tr ' ' '\n' | grep -qx "$f" || MANQUANTS="$MANQUANTS $f"
    done
    if [ -z "$MANQUANTS" ]; then
        CPU_EXPLOITABLE=1
        vuln "Le processeur a les 4 jeux d'instructions requis : Java exploitable s'il n'est pas à jour."
    else
        ok "Processeur x86-64 sans :$MANQUANTS -> faille non exploitable ici (mettre Java à jour quand même)."
    fi
fi

# -----------------------------------------------------------------------------
titre "2. Recherche sur tout le disque (patience, ça peut prendre quelques minutes)"
find / \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o \
     \( -type f -name release \
        -o -type f -name 'hs_err_pid*.log' \
        -o -path '*/bin/java' \
        -o -iname '*java4shell-exposure-audit*' \) -print 2>/dev/null > "$TMP_FIND"
info "$(wc -l < "$TMP_FIND") éléments à examiner."

# -----------------------------------------------------------------------------
titre "3. Environnements Java installés (JDK / JRE, y compris ceux embarqués dans des applis)"
NB_JAVA=0
JAVA_HOMES=""
while IFS= read -r f; do
    case "$f" in */release) ;; *) continue ;; esac
    grep -q '^JAVA_VERSION=' "$f" 2>/dev/null || continue
    NB_JAVA=$((NB_JAVA + 1))
    HOME_J="$(dirname "$f")"
    JAVA_HOMES="$JAVA_HOMES|$HOME_J|"
    V="$(grep -m1 '^JAVA_VERSION=' "$f" | cut -d= -f2 | tr -d '"')"
    IMPL="$(grep -m1 '^IMPLEMENTOR=' "$f" | cut -d= -f2 | tr -d '"')"
    case "$V" in 1.*) MAJ="$(echo "$V" | cut -d. -f2)" ;; *) MAJ="${V%%.*}" ;; esac
    DESC="$HOME_J  (Java $V${IMPL:+, $IMPL})"

    if grep -qi 'openj9' "$f"; then
        ok "$DESC -> OpenJ9, non concerné."; continue
    fi
    case "$MAJ" in
        8|11) ok "$DESC -> branche non concernée." ;;
        17) if ver_lt "$V" "17.0.6"; then ok "$DESC -> antérieur à 17.0.6, non concerné."
            elif ver_lt "$V" "17.0.21.1"; then vuln "$DESC -> à mettre à jour (corrigé en 17.0.21.1)."
            else ok "$DESC -> corrigé."; fi ;;
        21) if ver_lt "$V" "21.0.13.1"; then vuln "$DESC -> à mettre à jour (corrigé en 21.0.13.1)."
            else ok "$DESC -> corrigé."; fi ;;
        25) if ver_lt "$V" "25.0.5.1"; then vuln "$DESC -> à mettre à jour (corrigé en 25.0.5.1)."
            else ok "$DESC -> corrigé."; fi ;;
        27) if ver_lt "$V" "27.0.1.1"; then vuln "$DESC -> à mettre à jour (corrigé en 27.0.1.1)."
            else ok "$DESC -> corrigé."; fi ;;
        *)  vuln "$DESC -> version hors support, statut inconnu : à remplacer par une 21 ou 25 à jour." ;;
    esac
done < "$TMP_FIND"

# Binaires java sans fichier release (version illisible sans les exécuter)
while IFS= read -r f; do
    case "$f" in */bin/java) ;; *) continue ;; esac
    H="$(dirname "$(dirname "$f")")"
    case "$JAVA_HOMES" in *"|$H|"*) continue ;; esac
    NB_JAVA=$((NB_JAVA + 1))
    info "$f : version non lisible sans l'exécuter -> vérifier à la main (« $f -version »)."
done < "$TMP_FIND"

[ "$NB_JAVA" -eq 0 ] && ok "Aucun Java trouvé sur cette machine : rien à attaquer."

if command -v dpkg >/dev/null 2>&1; then
    PKG="$(dpkg -l 2>/dev/null | awk '/^ii/ && $2 ~ /(openjdk|temurin|corretto|zulu|java)/ {print "   " $2 "  " $3}')"
    [ -n "$PKG" ] && { info "Paquets Java installés via apt :"; echo "$PKG"; }
fi

# -----------------------------------------------------------------------------
titre "4. Programmes Java en cours d'exécution"
PIDS="$(pgrep -x java 2>/dev/null || true)"
if [ -z "$PIDS" ]; then
    ok "Aucun programme Java ne tourne en ce moment."
else
    for p in $PIDS; do
        CMD="$(tr '\0' ' ' < /proc/"$p"/cmdline 2>/dev/null | cut -c1-200)"
        info "PID $p : $CMD"
        case "$CMD" in
            *-XX:-UseBASE64Intrinsics*|*-XX:UseAVX=2*) ok "  PID $p : protection temporaire (option JVM) active." ;;
        esac
        # Signe d'exploitation : java qui lance un shell ou un outil de téléchargement
        ENFANTS="$(ps -o pid=,comm= --ppid "$p" 2>/dev/null | grep -Ew 'sh|bash|dash|zsh|python3?|perl|curl|wget|nc|ncat' || true)"
        [ -n "$ENFANTS" ] && alerte "  PID $p (java) a lancé : $(echo "$ENFANTS" | tr '\n' ' ') -> à examiner."
    done
    if command -v ss >/dev/null 2>&1; then
        ECOUTE="$(ss -ltnp 2>/dev/null | grep '"java"' || true)"
        [ -n "$ECOUTE" ] && { info "Ports ouverts par Java (exposés si 0.0.0.0, * ou [::]) :"; echo "$ECOUTE"; }
        SORTIE="$(ss -tnp state established 2>/dev/null | grep '"java"' || true)"
        [ -n "$SORTIE" ] && { info "Connexions établies par Java (vérifier les adresses inconnues) :"; echo "$SORTIE"; }
    fi
fi

# -----------------------------------------------------------------------------
titre "5. Traces de plantage de la JVM (signe possible de tentative d'attaque)"
NB_HS=0
while IFS= read -r f; do
    case "$f" in */hs_err_pid*.log) ;; *) continue ;; esac
    NB_HS=$((NB_HS + 1))
    D="$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)"
    if [ "$(date -r "$f" +%Y%m%d 2>/dev/null)" -ge 20261117 ] 2>/dev/null; then
        alerte "Plantage Java depuis la publication de la faille : $D  $f"
    else
        info "Plantage Java ancien (avant la faille) : $D  $f"
    fi
done < "$TMP_FIND"
[ "$NB_HS" -eq 0 ] && ok "Aucun fichier hs_err_pid*.log."

MOTIF_CRASH='fatal error has been detected by the Java Runtime|SIGSEGV.*(libjvm|java)'
if command -v journalctl >/dev/null 2>&1; then
    J="$(journalctl --no-pager --since 2026-11-17 2>/dev/null | grep -E "$MOTIF_CRASH" | head -n 20 || true)"
    if [ -n "$J" ]; then alerte "Plantages Java dans le journal système :"; echo "$J"
    else ok "Aucun plantage Java dans le journal système depuis le 17/11."; fi
fi

# -----------------------------------------------------------------------------
titre "6. Tentatives d'attaque dans les journaux (/var/log)"
MOTIF_ATTAQUE='java4shell|A{64}=|Base64 Heap Overflow'
TROUVE=0
while IFS= read -r f; do
    R="$(zgrep -aiE "$MOTIF_ATTAQUE" "$f" 2>/dev/null | head -n 5 || true)"
    if [ -n "$R" ]; then
        TROUVE=1
        alerte "Motif d'attaque dans $f :"
        echo "$R" | cut -c1-250
    fi
done < <(find /var/log -type f \( -name '*.log' -o -name '*.log.*' -o -name 'syslog*' -o -name 'messages*' -o -name '*access*' \) 2>/dev/null)
[ "$TROUVE" -eq 0 ] && ok "Aucun motif d'attaque Java4Shell dans /var/log."

# -----------------------------------------------------------------------------
titre "7. Leurre malveillant connu (faux outil d'audit Java4Shell)"
L="$(grep -i 'java4shell-exposure-audit' "$TMP_FIND" || true)"
if [ -n "$L" ]; then alerte "Faux outil malveillant trouvé : ne pas l'exécuter :"; echo "$L"
else ok "Faux outil « java4shell-exposure-audit » absent."; fi

# -----------------------------------------------------------------------------
titre "BILAN"
echo "Java vulnérables ou à remplacer : $NB_VULN"
echo "Alertes à examiner              : $NB_ALERTE"
if [ "$NB_VULN" -eq 0 ] && [ "$NB_ALERTE" -eq 0 ]; then
    echo "-> Rien à signaler sur cette machine."
else
    [ "$NB_VULN" -gt 0 ] && echo "-> Mettre Java à jour (sudo apt update && sudo apt full-upgrade, ou l'appli qui l'embarque)."
    [ "$CPU_EXPLOITABLE" -eq 1 ] && echo "-> En attendant : option JVM -XX:-UseBASE64Intrinsics puis redémarrage du programme."
    [ "$NB_ALERTE" -gt 0 ] && echo "-> Les alertes ne prouvent pas une infection : envoie-moi le rapport pour analyse."
fi
echo "Rapport complet : $REPORT"
